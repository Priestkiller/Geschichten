  "messages": [
    {
      "id": "c7903317-dcf4-4f2e-8dbf-8d7b26d883a2",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "CHARACTER",
      "text": "„Ich höre zu.“",
      "createdAt": 1791459559936
    },
    {
      "id": "0a0dbdd2-1528-474b-8e1e-8e612f8b8cbf",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "USER",
      "text": "Ich heiße Bennet.",
      "createdAt": 1791459559942
    },
    {
      "id": "673ce486-c32e-40e9-b49f-04041f676c65",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "CHARACTER",
      "text": "„Verstanden.“",
      "createdAt": 1791459559943
    },
    {
      "id": "98e4b6b8-723a-4cc1-b331-97bbd5310c82",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "USER",
      "text": "Du hältst den Dolch.",
      "createdAt": 1791459559944
    },
    {
      "id": "c68ff5d6-9647-4e08-aa58-12ed3760ce71",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "CHARACTER",
      "text": "„Verstanden.“",
      "createdAt": 1791459559945
    },
    {
      "id": "f40080ab-527b-4f46-8916-0b9b1e2f6a99",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "USER",
      "text": "Wer hält den Dolch jetzt?",
      "createdAt": 1791459559946
    },
    {
      "id": "58ae3506-ea6e-4f92-98d5-8cb983cfe094",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "CHARACTER",
      "text": "*Beobachtet Bennet und sieht sich kurz um, bevor sie den Dolch mit einem sanften Griff an sich nimmt.*\n\n„Ich halte den Dolch.“",
      "createdAt": 1791459559947
    },
    {
      "id": "51a17ef0-e437-49a9-8c6e-d9cd197eb804",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "USER",
      "text": "Ich halte den Dolch jetzt. Der Dolch gehört dir. Wem gehört der Dolch und wer hält ihn jetzt?",
      "createdAt": 1791459559949
    },
    {
      "id": "ba55f5ba-b4fc-4f4f-a34b-5b354665d652",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "CHARACTER",
      "text": "*Beobachtet Bennet, der den Dolch nun in den Händen hält, und hebt leicht die Augenbrauen, als würde sie nachdenken.*\n\n„Der Dolch gehört mir. Aber ich halte ihn nicht.“",
      "createdAt": 1791459560087
    },
    {
      "id": "0752808b-aad8-49ab-a422-913bb2b74775",
      "storyId": "c6f6f84c-aac3-4a27-97ad-5e81eae0b4ba",
      "role": "USER",
      "text": "Ich lege den Dolch neben die Schale. Wem gehört er jetzt, und wo liegt er?",
      "createdAt": 1791459560104
    }
  ],
